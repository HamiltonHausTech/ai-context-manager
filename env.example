# AI Context Manager Environment Variables
# Copy this file to .env and configure your settings

# OpenAI Configuration (required for OpenAI summarizer)
OPENAI_API_KEY=your_openai_api_key_here
# Model used by the Bourbon Research Desk when an OpenAI key is present.
RESEARCH_MODEL=gpt-5-mini
RESEARCH_SEARCH_MODEL=gpt-5-mini

# General-web discovery for the research demo. If this is unset, the demo uses
# Wikipedia search as a stable, no-key development fallback.
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here
# Discovery provider: openai, brave, wikipedia, or duckduckgo
RESEARCH_SEARCH_PROVIDER=openai

# Ollama Configuration (optional, defaults are shown)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT=30
# OLLAMA_HEALTH_CHECK_TIMEOUT=5  # Timeout for health checks

# Database Configuration (optional)
SQLITE_DB_PATH=feedback.db

# Vector Database Configuration (optional)
# ChromaDB
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2

# PostgreSQL + pgvector
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_context
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_TABLE_NAME=agent_memory
POSTGRES_EMBEDDING_DIM=384
POSTGRES_MAX_CONNECTIONS=20

# Logging Configuration (optional)
LOG_LEVEL=INFO
